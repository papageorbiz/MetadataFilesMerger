<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <!-- Leave blank to prompt for a folder when the program starts. -->
        <add key="PrimaryFolder" value="C:\Temp\msgs\nordic export"/>
        <add key="SecondaryFolder" value="C:\Temp\msgs\sedna export"/>
        <add key="OutputFolder" value="C:\Temp\msgs\merged"/>
        <!-- Leave blank to store logs in the _logs folder under OutputFolder. -->
        <add key="LogFolder" value=""/>
        <!-- Pipe-separated exact or wildcard expressions that start a new folder path. -->
        <add key="FolderStartPatterns" value="Smart folder|*-Private"/>
        <!-- True merges from secondary JSON only paths that match FolderStartPatterns. -->
        <add key="MergeOnlyTemplateMatchingPaths" value="False"/>
        <!-- 0 selects a sensible value based on the machine's processor count. -->
        <add key="WorkerCount" value="0"/>
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>
</configuration>
